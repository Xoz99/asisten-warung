# Aplikasi manajemen Konsulin - jalan SENDIRI (proses pm2 & domain terpisah dari aplikasi produk).
PORT=4100
# Berapa lapis proxy di depan (Caddy/nginx) - buat rate limit. Isi 1 kalau di belakang satu reverse proxy.
TRUST_PROXY=0

# Rahasia buat tanda tangan sesi login admin. Minimal 16 karakter. Bikin: openssl rand -hex 32
MANAJEMEN_JWT_SECRET=
# Kunci SEKALI PAKAI buat bikin admin pertama (layar "Buat admin pertama"). Admin berikutnya ditambah dari halaman Admin.
# Minimal 16 karakter. Bikin: openssl rand -hex 24
ADMIN_KEY=
# Database akun admin & catatan aktivitas (tabel mj_*). Kosong = ikut WARUNG_PINTAR_DATABASE_URL.
MANAJEMEN_DATABASE_URL=

# ---- Produk: Warung Pintar ----
# Database Warung Pintar (sama kayak DATABASE_URL di warung-pintar-backend/.env). Kosong = produk ini nggak tampil.
WARUNG_PINTAR_DATABASE_URL=
# Alamat aplikasi Warung Pintar - dipakai buat bikin link sales (…/?ref=KODE).
WARUNG_PINTAR_URL=https://asistenwarung.konsulin.com
# Alamat publik form lamaran Sales Partner (halaman karir di landing page). Link yang disalin di Rekrutmen pakai ini,
# dan /daftar di domain makalin dialihin ke sini. Kosong = pakai form bawaan di domain makalin sendiri.
DAFTAR_URL=https://konsulin.com/karir

# Folder CV & foto pelamar (form daftar Sales Partner). Kosong = manajemen/data/dokumen. Masukin ke backup server.
DOKUMEN_DIR=

# Artifact (gudang dokumen): lokasi file di server & batas ukuran per file. Default: manajemen/data/artifact, 300 MB.
# ARTIFACT_DIR=/home/ubuntu/makalin-artifact
# ARTIFACT_MAKS_MB=300

# Email pemberitahuan (pencairan bagi hasil, rekening sales diganti) lewat SMTP - penyedia apa aja.
# Kosong = nggak ngirim email (pemberitahuan tetap muncul di app). SMTP_HOST=uji = cuma buat tes lokal, nggak ngirim.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_DARI="Makalin <noreply@konsulin.com>"
MAKALIN_URL=https://makalin.konsulin.com

# Alamat publik buat link kuis & pilih jadwal kandidat rekrutmen (halaman /kuis/... dan /jadwal/... di landing).
PUBLIK_URL=https://konsulin.com

# AI Chat: hanya server, jangan gunakan prefix VITE_.
GROQ_API_KEY=
# Kosong = pakai 3 model Groq bawaan (GPT-OSS 120B, Qwen 3.8 27B, GPT-OSS 20B), dicoba berurutan kalau yang depan penuh/error.
# Isi satu model di GROQ_MODEL, atau sampai 6 model (dipisah koma) di GROQ_MODELS. Model harus bisa pakai tools.
GROQ_MODEL=
GROQ_MODELS=
# Batas harian, reset 00.00 WIB: pesan per admin (0 = tanpa batas) dan total token semua admin (0 = tanpa batas; pakai kalau model berbayar).
AI_PESAN_HARIAN=50
AI_TOKEN_HARIAN=0
# Laporan otomatis Kantor Konsulin dicek tiap menit di proses server ini. 0 = matikan penjadwalnya. Tiap laporan
# terjadwal makan 1 pesan dari jatah harian admin pemilik jadwalnya.
KANTOR_PENJADWAL=1
