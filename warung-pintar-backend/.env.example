DATABASE_URL=postgres://user:password@localhost:5432/warung_pintar
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
PORT=4000

# Lisensi/langganan lewat Midtrans (dijual dari landing page Konsulin)
# Ambil dari dashboard.midtrans.com > Settings > Access Keys. Pakai Sandbox dulu buat testing.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Batasi metode bayar yang muncul di halaman Snap (dipisah koma, mis. "qris" atau "qris,gopay").
# Kosongin = semua metode yang aktif di akun merchant ikut muncul.
# Kenapa dibatasi: MDR tiap metode beda jauh & di paket murah bedanya menentukan - QRIS motong
# 0,7% (Rp 350 dari paket 50rb) tapi retail Indomaret motong Rp 5.000 flat, alias 10%.
MIDTRANS_METODE=qris
# URL app Warung Pintar yang dibuka pelanggan sehari-hari (buat redirect setelah bayar)
APP_BASE_URL=http://localhost:5173

# AI "Mang Warung" (asisten.routes.js) & scan nota (nota.routes.js) - jawaban natural + baca foto.
# Ambil dari aistudio.google.com/apikey (ada free tier). Tanpa ini, Mang Warung tetap jalan tapi
# jawabannya jatuh ke rule-based kaku, dan scan nota jatuh ke Tesseract (lebih lemah bacanya).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Cadangan KEDUA buat Mang Warung (openrouter.service.js) - dicoba kalau Gemini gagal/kena quota,
# SEBELUM jatuh ke rule-based. Opsional - kosongin aja kalau belum mau pasang, fiturnya tetap jalan
# (langsung ke rule-based kalau Gemini gagal, sama kayak sebelum ini ada). Ambil key dari
# openrouter.ai/keys, daftar model & harganya di openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Gateway WhatsApp buat kirim kode OTP (lupa kata sandi & ganti PIN - lihat auth.routes.js).
# Tanpa ini alurnya TETAP jalan penuh, cuma kodenya nggak terkirim: dicatat di log server aja
# (cari baris "[wa] TIDAK TERKIRIM") - cukup buat development, TAPI JANGAN dipakai produksi,
# karena artinya nggak ada satu pun user yang bisa nerima kodenya.
# WA_PROVIDER: fonnte (default) atau wablas - dua-duanya gateway WA lokal, daftar di fonnte.com
# atau wablas.com, tokennya ambil dari dashboard masing-masing.
WA_PROVIDER=fonnte
WA_TOKEN=
