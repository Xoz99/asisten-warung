  "private": true,
  "type": "module",
  "description": "Backend API Warung Pintar \u2014 sesuai PRD (auth, produk/stok, transaksi, kasbon, pelanggan, serah terima jaga, laporan, OCR nota, voice parsing, visual/face matching, cuaca, asisten, koperasi digital, langganan sembako, tukar tambah stok)",
  "scripts": {
